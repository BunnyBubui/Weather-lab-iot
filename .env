# ---- MQTT ----
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_TOPIC_SUB=weather/+/data

# ---- MongoDB ----
MONGO_URL=mongodb://mongodb:27017
DB_NAME=weather_db
COLLECTION_NAME=weather_readings

# ---- Station status threshold (seconds) ----
ONLINE_THRESHOLD_SECONDS=15

# ---- Web App ----
WEBAPP_PORT=8000
